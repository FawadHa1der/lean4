diff --git a/stage0/src/include/lean/lean.h b/stage0/src/include/lean/lean.h
index 824d6cfa86..81de49a643 100644
--- a/stage0/src/include/lean/lean.h
+++ b/stage0/src/include/lean/lean.h
@@ -3304,7 +3304,12 @@ static inline lean_obj_res lean_runtime_hold(b_lean_obj_arg a) {
     return lean_box(0);
 }
 
-#ifdef LEAN_EMSCRIPTEN
+// An 8-byte scalar packed into pointer-sized `m_objs` slots: two slots on
+// 32-bit targets, one on 64-bit. Gate on pointer width, not just Emscripten —
+// a native 32-bit build (e.g. the stage0 of the wasm cross-build) must take the
+// two-slot form, or the 64-bit cast truncates the value and leaves the second
+// slot zero, silently corrupting statically-emitted scalars such as Name hashes.
+#if defined(LEAN_EMSCRIPTEN) || UINTPTR_MAX == UINT32_MAX
 #define LEAN_SCALAR_PTR_LITERAL(b1, b2, b3, b4, b5, b6, b7, b8) (lean_object*)((uint32_t)b1 | ((uint32_t)b2 << 8) | ((uint32_t)b3 << 16) | ((uint32_t)b4 << 24)), (lean_object*)((uint32_t)b5 | ((uint32_t)b6 << 8) | ((uint32_t)b7 << 16) | ((uint32_t)b8 << 24))
 #else
 #define LEAN_SCALAR_PTR_LITERAL(b1, b2, b3, b4, b5, b6, b7, b8) (lean_object*)((uint64_t)b1 | ((uint64_t)b2 << 8) | ((uint64_t)b3 << 16) | ((uint64_t)b4 << 24) | ((uint64_t)b5 << 32) | ((uint64_t)b6 << 40) | ((uint64_t)b7 << 48) | ((uint64_t)b8 << 56))
diff --git a/stage0/src/runtime/thread.cpp b/stage0/src/runtime/thread.cpp
index d4b50d3f72..0acdfe4a58 100644
--- a/stage0/src/runtime/thread.cpp
+++ b/stage0/src/runtime/thread.cpp
@@ -22,7 +22,10 @@ Author: Leonardo de Moura
 #include "runtime/sstream.h"
 
 #ifndef LEAN_DEFAULT_THREAD_STACK_SIZE
-#ifdef LEAN_EMSCRIPTEN
+// Gate on pointer width, not just Emscripten: a 1GB thread stack cannot be
+// reserved in a native 32-bit address space (e.g. the stage0 of the wasm
+// cross-build), making every pthread_create fail.
+#if defined(LEAN_EMSCRIPTEN) || UINTPTR_MAX == UINT32_MAX
 #define LEAN_DEFAULT_THREAD_STACK_SIZE 8*1024*1024 // 8MB for 32-bit
 #else
 #define LEAN_DEFAULT_THREAD_STACK_SIZE 1024*1024*1024 // 1GB for 64-bit
